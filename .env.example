# Copy this file to .env and fill in your real values. .env is gitignored.
# CRA only exposes variables prefixed with REACT_APP_ to the frontend.

# YouTube Data API v3 key (create at https://console.cloud.google.com/apis/credentials)
REACT_APP_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your YouTube channel id (24 chars, starts with "UC").
# Find it at https://www.youtube.com/account_advanced
REACT_APP_YOUTUBE_CHANNEL_ID=UC_your_channel_id_here
